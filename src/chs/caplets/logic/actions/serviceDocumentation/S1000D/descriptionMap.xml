<!--
Make a  descriptive DMC .  This contains no connectivity  
-->
<maps>
    <map independent='true'>
        <target>
            <path val= 'content'/>
            <path val= 'description'/>
        </target>
        <source>
            <path val='XLogicDiagram'/>
        </source>
        <copy target ='title' source = "@description" skipblank='Y'/>
        <call target='levelledPara' source ='$self'/>
    </map>
    <map target  = 'levelledPara' source  = 'XLogicDesign'>
        <copy target ='title' source = "@shortdescription" skipblank='Y'/>
        <call target='figure' source ='$self'/>
    </map>
    <map target  = 'figure' source  = 'XLogicDesign'>
        <copy target ='@xmlns' constant = 'http://www.Customer.com/XSD/customerApplication'/>
        <copy target ='title' source = "@description" skipblank='Y'/>
        <copy target ='@xxx' constant = 	"xxx"/>
        <call target='graphic' source ='XLogicDiagram'/>
    </map>
    <map target ='graphic' source  = 'XLogicDiagram'>
        <copy target ='@infoEntityIdent' source ="@icnRef"/>
        <copy target ='@reproductionHeight' constant ="130mm"/>
        <copy target ='@reproductionScale' constant ="1"/>
    </map>
</maps>
