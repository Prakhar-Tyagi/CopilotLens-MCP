    <!-- CONTROL OF WHAT DISPLAYED ON THE CGM DIAGRAM.
	
	The SetOfDisplayAttributes node allows configuration of what is displayed on the CGM diagram.
    
	Setting up the system.
	If there are no 'SetOfDisplayAttributes' nodes  then all attributes will be displayed. This is usually far too many, but is useful in determining which items are available for display.
    Notice that DisplayAttributes includes both built-in 'attributes' (in Capital terminology) and custom added 'properties' (in capital terminology).
	
	If SetOfDisplayAttributes is present then the display is in the order specified here - otherwise it is simply in alphabetical order.
	
	Within  the SetOfDisplayAttributes please add a node for each attribute.  The attribute name  is case sensitive.
	In these nodes if there is no 'skipWhen' when clause then the attribute is always displayed. 
    Evaluation of the skipwhen clause is not case sensitive   
    The word '$Null' in a skipWhen clause  (itself case sensitive) has special meaning .  '$Null' is interpreted  as not display if the attribute has zero length,  or is not present
    To skip a numeric attribute the value '0.0' is most effective - that is assuming that zero is an attribute value of no interest.
	The 'displayName' Attribute is optional.  If 'displayName'   is present then it replaces the name used as a key (in Capital) - see example belows.
	
	The attributes display may be customized according to the object type or values of attributes. We use  'AllDisplayAttributes' for this purpose. 
	
	The FIRST 'SetOfDisplayAttributes that has a valid 'ConditionsForApplicability' will be selected. 
	Within ConditionsForApplicability ALL Rules must have valid criteria to be selected (AND logic) 
	Within OptionalRuleGroup ANY Rule with valid criteria will cause selection (OR logic) 
	ConditionsForApplicability/OptionalRuleGroup objects my be nested to any depth.
	A rule must have a 'criteria'.  This is the case senstive name of the attibute or the reserved name '$ObjectType$' to see/test the raw object type. (For any given object its '$ObjectType$ will be resemble 'XLogicDiagramPinList, XLogicDiagramConductor, XLogicDiagramMultiCore'). 
    Rules may test for equality, containment, or range (i.e. part numbers)
	For equality use the attribute 'equals'   as in:  equals='SpecialValue'
	For containment use the attribute 'contains'   as in:  contains='Conductor'
	For range specify  minimum and maximum attributes.  (Range is strictly between bounds by default)
	If the attribute isNumeric  is set to 'y' then range comparions are numeric (strictly between bounds.)
	If the attribute includeBounds is set to 'y' then range comparions also include the range bound values 
	If the attribute ignoreCase is set to 'y' then comparions for validity ignores case (default is to consider case in a ConditionsForApplicability.)
	(To test on substrings use a plugin and prepare a Capital custom property with the subsset value).
	
	Use 'showChoiceInLog' to add details of the selection to the S1000D loging file. It will use 'name' on the SetOfDisplayAttributes 
	in that logging report. 

	To further enhance the display  Lookups defined in this file may be  applied on an attribute by attribute basis as in :	 
	 <Item name='PartAssigned'  lookUp = 'customBoolean'/>
	 This example translates the strings via the 'customBoolean' lookup example below.
	 If the 'customBoolean' lookup does not exist the string values remain unchanged. 
	 Else the string values are mapped as described in lookup comments below. 

	-->
    <AllDisplayAttributes showChoiceInLog='y'>
	
	       <SetOfDisplayAttributes name= 'RegTestSetOne'>
            <ConditionsForApplicability>      
                <OptionalRuleGroup>			
                    <Rule criteria = 'XXX' equals='C'/>  
                    <Rule criteria = 'YYY' minimum='4' maximum = '24' isNumeric = 'y' includeBounds='y'/>
                </OptionalRuleGroup>						
            </ConditionsForApplicability>
			<Item constantText = 'ConditionsForApplicability is XXX=C Or (4 less than YYY less than 24)' />;
			 <Item name='Name'/>
			 <Item name='PartNumber'/>	
			 <Item constantText='--------------------------'/> 
             <Item name='XXX'/>			 
             <Item name='YYY'/>			 
        </SetOfDisplayAttributes>
		
		 <SetOfDisplayAttributes name= 'RegTestSetTwo'>
            <ConditionsForApplicability>   
                 <Rule criteria = 'XXX' minimum='C' maximum = 'D' includeBounds='y'/>
            </ConditionsForApplicability>
			<Item constantText = 'ConditionsForApplicability XXX between C and D' />;
			 <Item name='Name'/>
			 <Item name='PartNumber'/>
            <Item constantText='--------------------------'/> 
             <Item name='XXX'/>			 
             <Item name='YYY'/>						 
        </SetOfDisplayAttributes>
		
		 <SetOfDisplayAttributes name= 'RegTestSetThree'>
            <ConditionsForApplicability>   
               <Rule criteria = 'XXX' equals='a' ignoreCase='y'/>  
            </ConditionsForApplicability>
			<Item constantText = 'ConditionsForApplicability XXX ignoreCase is "a" ' />;
			 <Item name='Name'/>
			 <Item name='PartNumber'/>	
             <Item constantText='--------------------------'/> 
             <Item name='XXX'/>			 
             <Item name='YYY'/>				 
        </SetOfDisplayAttributes>
	
	    <SetOfDisplayAttributes name= 'SpecialSet'>
            <ConditionsForApplicability>             			
                    <Rule criteria = 'PartNumber' contains='SWCH'/>            
            </ConditionsForApplicability>
			<Item constantText = 'ConditionsForApplicability is SpecialSet' />;
			 <Item name='Name'/>
			 <Item name='PartNumber'/>
			 <Item constantText = '==========================' />;
			 <Item constantText = 'SWITCHES FROM SPECIAL RULE' />;
			 <Item name='ColorCode' skipWhen = '$Null' lookUp = 'customColour'/>
        </SetOfDisplayAttributes>
		
		<SetOfDisplayAttributes name= 'PlugConnectors'>
            <ConditionsForApplicability>             		
               <Rule criteria = '$ObjectType$' contains='PinList'/>
               <Rule criteria = 'Plug' equals='true' ignoreCase='y'/>              
            </ConditionsForApplicability>
			 <Item name='Name'/>
			 <Item name='PartNumber'/>
			 <Item constantText = '=======P=L=U=G================' />;
			 <Item constantText = 'PinList which is plug' />;
			 <Item name='ColorCode' lookUp = 'customColour'/>
        </SetOfDisplayAttributes>
	
	
        <SetOfDisplayAttributes name= 'Connectors'>
            <ConditionsForApplicability>
                <OptionalRuleGroup>
                    <!--Rule criteria = 'PartNumber' minimum='9197930000' maximum = '9197960000' isNumeric = 'y' includeBounds='y'/-->
                    <Rule criteria = 'GroupName' equals='Connector' ignoreCase='y'/>
                    <!-- Attribute not recognized Rule criteria = 'Connector usage' equals='Connector' ignoreCase='y'/-->
                    <!--Rule criteria = '$ObjectType$' contains='PinList'/-->
                    <Rule criteria = 'Plug' equals='true' ignoreCase='y'/>
                    <Rule criteria = 'Inline' equals='true' ignoreCase='y'/>
                </OptionalRuleGroup>
            </ConditionsForApplicability>
            <Item name='Name'/>
            <Item constantText = 'Component Type:Connector'/>
            <Item name='PartNumber'/>
            <Item name ='Harness'/>
        </SetOfDisplayAttributes>
		
