    <!-- In order to make the display neater we can add any number of lookups/
	Lookups are applied by name on an attribute by attribute basis.
	This example maps 'true' and 'false' to their equivalents.
	These mappings uses exact matches.  If no match then the original string is returned.
	These mappings are case sensitive
	The mapping is applied AFTER the evaluation of the 'skipWhen' rule. This is a pure string to string mapping.	
	For full scale language tranlsation it is better to use the Capital language feature -
	then the language specified at generation will be applied. 
	-->
    <AttributeLookUps>
        <lookUp name = 'customBoolean'>
            <entry input='true' output = 'wahr'/>
            <entry input='false' output = 'falsch'/>
        </lookUp>
        <lookUp name = 'customNumber'>
            <entry input='0.0' output = '0'/>
            <entry input='NaN' output = 'Not-A-Number'/>
        </lookUp>
		
		 <lookUp name = 'customColour'>
            <entry input='B' output = 'Glas (Blue)'/>
            <entry input='R' output = 'Coch (Red)'/>
            <entry input='Y/S' output = 'Melyn/Arian (Yellow Silver)'/>
            <entry input='Y/U' output = 'Melyn/Llwyd (Yellow Uncoloured)'/>
            <entry input='BL/ws' output = 'Bl/ws (coch ?) '/>
        </lookUp>
		
    </AttributeLookUps>	

    <!-- If ProduceAllDesignTypes is set to 'n' (- which is the default)  - then Publisher only consider wiring diagrams. 
	If set to 'y' we consider all diagrams for potential CGM generation. 	
	Publisher scoping is only applied if this flag is set to 'n.' If the flag is set to 'y' 
	then  Publisher will always publish all diagrams in the project.-->
    <ProduceAllDesignTypes val='n'/>
	
	
		

