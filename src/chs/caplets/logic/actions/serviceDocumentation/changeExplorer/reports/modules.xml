<report name="Modules" summary-included="true" composite-changes-included="true">
    <tables name="Functional Modules"
            apply-to="functional-module"
            types="modified added removed"
            sorted-by="{Name}">
        <!--
            Allowed column types - attribute, property, computed

            Accepted 'computed' types - ApplicableModuleCodes
        -->
        <column type="attribute" key="Name" name="{Name}"/>
        <column type="attribute" key="PartNumber" name="{Part Number}"/>
        <column type="attribute" key="Revision" name="{Revision}"/>
        <column type="attribute" key="ShortDescription" name="{Short Description}"/>
        <column type="attribute" key="ReleaseLevel" name="{Release Level}"/>
        <column type="computed" key="ApplicableModuleCodes" name="{Applicable Module Codes}"/>
    </tables>
    <tables name="Functional Module Codes"
            apply-to="functional-module-code"
            types="modified added removed unmodified"
            sorted-by="{Name}">
        <!--
            Allowed column types - attribute, property, computed

            Accepted 'computed' types - Includes, Excludes
        -->
        <column type="attribute" key="Name" name="{Name}"/>
        <column type="computed" key="Includes" name="{Includes}"/>
        <column type="computed" key="Excludes" name="{Excludes}"/>
    </tables>
    <tables name="Production Modules"
            apply-to="production-module"
            types="modified added removed"
            sorted-by="{Name}">
        <!--
            Allowed column types - attribute, property, computed

            Accepted 'computed' types - ApplicableModuleCodes
        -->
        <column type="attribute" key="Name" name="{Name}"/>
        <column type="attribute" key="PartNumber" name="{Part Number}"/>
        <column type="attribute" key="Revision" name="{Revision}"/>
        <column type="attribute" key="ShortDescription" name="{Short Description}"/>
        <column type="attribute" key="ReleaseLevel" name="{Release Level}"/>
        <column type="computed" key="ApplicableModuleCodes" name="{Applicable Module Codes}"/>
    </tables>
    <tables name="Production Module Codes"
            apply-to="production-module-code"
            types="modified added removed unmodified"
            sorted-by="{Name}">
        <!--
            Allowed column types - attribute, property, computed

            Accepted 'computed' types - Includes, Excludes
        -->
        <column type="attribute" key="Name" name="{Name}"/>
        <column type="computed" key="Includes" name="{Includes}"/>
        <column type="computed" key="Excludes" name="{Excludes}"/>
    </tables>
</report>